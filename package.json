{
    "name": "hr1",
    "private": true,
    "description": "HR1 - Merchandising Management System (plain PHP + Tailwind CSS for future UI work)",
    "scripts": {
        "build": "tailwindcss -i ./assets/css/tailwind.src.css -o ./assets/css/tailwind.css --minify",
        "watch": "tailwindcss -i ./assets/css/tailwind.src.css -o ./assets/css/tailwind.css --watch",
        "react:build": "vite build",
        "react:dev": "vite",
        "spa:dev": "vite --config react/spa/vite.config.mts",
        "spa:build": "vite build --config react/spa/vite.config.mts",
        "spa:typecheck": "tsc -p react/spa/tsconfig.json --noEmit",
        "vue:build": "vite build --config vue/vite.config.js",
        "vue:dev": "vite --config vue/vite.config.js"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "autoprefixer": "^10.4.21",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.9.2",
        "vite": "^8.2.2",
        "vue": "^3.5.41",
        "vue-router": "^4.6.4"
    },
    "dependencies": {
        "lucide-react": "^1.44.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.9.0",
        "recharts": "^3.10.1"
    }
}
