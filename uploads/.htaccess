# Private documents (resumes, employee files) must never be served directly.
# Legitimate access goes through authorized PHP handlers that stream files
# after checking the session and role. Images (profile photos) stay public.
<FilesMatch "\.(pdf|doc|docx|xls|xlsx|ppt|pptx|zip|rar|7z)$">
    Require all denied
</FilesMatch>

Options -Indexes
