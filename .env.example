# HR1 environment configuration
# Copy this file to .env and fill in real values. A .env file is optional:
# real server environment variables always take precedence, and placeholder
# values below (your_*) are ignored so this example can never act as config.

# Application mode: development | staging | production
APP_ENV=development

# Canonical public base URL (no trailing slash) used for email link building.
# Required in production; must start with https://
APP_URL=https://hr1.example.com

# Path prefix the app is served from. Use /HR1 for the local XAMPP htdocs
# layout, or leave EMPTY for a domain/VirtualHost served from the app root.
HR1_BASE_URL=/HR1

# Database (production requires host/name/user/pass; user must not be root)
HR1_DB_HOST=your_db_host
HR1_DB_NAME=your_db_name
HR1_DB_USER=your_db_user
HR1_DB_PASS=your_db_password
HR1_DB_PORT=3306

# SMTP relay — production email delivery is sent via this server
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com
# SMTP_ENCRYPTION: tls (STARTTLS, typical for 587), ssl (implicit TLS, 465) or none
SMTP_ENCRYPTION=tls

# Sender address shown in email headers (SMTP_FROM defaults to this)
HR1_MAIL_FROM=no-reply@example.com

# Comma/space separated peer IPs (the reverse proxies) allowed to forward
# X-Forwarded-Proto so HTTPS detection works behind a TLS terminator.
# Leave empty when the app runs directly behind full HTTPS.
HR1_TRUSTED_PROXIES=203.0.113.10

# API cross-origin allowlist (comma separated). In production, leaving this
# unset disables cross-origin CORS entirely; same-origin calls still work.
HR1_API_ALLOWED_ORIGINS=https://hr1.example.com

# Resume-parsing binaries. Leave EMPTY to resolve via the system PATH
# (pdftotext / antiword / catdoc / tesseract must be on PATH in that case).
PDTOTEXT_PATH=
TESSERACT_PATH=
ANTIWORD_PATH=
CATDOC_PATH=

# Optional: absolute path to the server-side error log file (production)
HR1_ERROR_LOG=C:\path\to\hr1-error.log

# Optional: Windows development-only sendmail.exe fallback (used only when
# SMTP_HOST is empty). Ignore/unset on non-Windows servers.
HR1_SENDMAIL_PATH=

# Backup configuration
# Path to the mysqldump binary. REQUIRED in production (e.g. /usr/bin/mysqldump).
# Leave EMPTY in development to resolve mysqldump via the system PATH only.
MYSQLDUMP_PATH=
# Backup storage directory. Leave EMPTY to use storage/backups/ (default,
# web-access blocked by .htaccess). When set, must be outside this application's
# web-exposed directories.
HR1_BACKUP_PATH=
# Optional age-based retention in days (e.g. 30). Leave EMPTY to rely on the
# default count-based rotation (newest 30 backups kept). Backups are NEVER
# deleted by age unless this is explicitly configured.
HR1_BACKUP_RETENTION_DAYS=