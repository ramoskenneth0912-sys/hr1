{
  "name": "hr1-node-api",
  "version": "0.1.0",
  "private": true,
  "description": "HR1 parallel Node.js + Express backend (Phase 2). Same DB, same API contracts — mounts beside the existing PHP API.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
