# HR1 Node API — environment configuration
# Copy to .env and adjust. NEVER commit real secrets.

# --- Server ---
NODE_ENV=development
PORT=4000
API_BASE=/api/v1
CORS_ORIGIN=http://localhost:5174

# --- MySQL (EXISTING hr1_database; read-only user) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hr1_database
DB_USER=hr1_node
DB_PASS=change-me
DB_CONNECTION_LIMIT=10

# --- Health ---
HEALTH_DB_TIMEOUT_MS=5000

# --- Auth (Auth.js / @auth/express foundation) ---
# Random 32+ byte secret used to sign/encrypt JWT sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me